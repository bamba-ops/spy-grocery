{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "spygrocery.com"
        }
      ],
      "destination": "https://www.spygrocery.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "app.spygrocery.com"
        }
      ],
      "destination": "https://www.spygrocery.com/$1",
      "permanent": true
    }
  ]
}
